{
  "version": 2,
  "name": "tayoca-com-static",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/access/book",
      "destination": "https://n8n.tayoca.com/webhook/tayoca/books/access"
    },
    {
      "source": "/ai-leverage-week/replay-ended",
      "destination": "/ai-leverage-week/replay-ended.html"
    }
  ],
  "redirects": [
    {
      "source": "/aiweek",
      "destination": "https://n8n.tayoca.com/form/ai-leverage-week-2026-register",
      "permanent": false
    },
    {
      "source": "/aiweek-meta",
      "destination": "https://n8n.tayoca.com/form/ai-leverage-week-2026-register?utm_source=meta&utm_medium=organic_social&utm_campaign=ai_leverage_week_sep28",
      "permanent": false
    },
    {
      "source": "/blog/kubernetes-production-checklist.html",
      "destination": "/blog/kubernetes-production-readiness-checklist-for-2026.html",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/writing.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "/assessments.html",
      "permanent": true
    },
    {
      "source": "/insights.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/sitesupply-construction-procurement-marketplace.html",
      "destination": "/work.html",
      "permanent": true
    },
    {
      "source": "/landing_ai-automation-career-page.html",
      "destination": "/products/ai-automation-career-playbook.html",
      "permanent": true
    },
    {
      "source": "/landing_ai-automation-career.html",
      "destination": "/products/ai-automation-career-playbook.html",
      "permanent": true
    },
    {
      "source": "/landing_n8n-mcp-k8s-page.html",
      "destination": "/products/n8n-mcp-kubernetes-teaching-pack.html",
      "permanent": true
    },
    {
      "source": "/landing_n8n-mcp-k8s.html",
      "destination": "/products/n8n-mcp-kubernetes-teaching-pack.html",
      "permanent": true
    },
    {
      "source": "/landing-devops-pack.html",
      "destination": "/products/build-break-fix-devops-lab-pack.html",
      "permanent": true
    },
    {
      "source": "/landing.html",
      "destination": "/products/aws-cost-optimization-playbook.html",
      "permanent": true
    },
    {
      "source": "/landing_v2.html",
      "destination": "/products/aws-cost-optimization-playbook.html",
      "permanent": true
    },
    {
      "source": "/l/aws-finops-playbook",
      "destination": "/products/aws-cost-optimization-playbook.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/landing_ai-made-simple.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow, noarchive"
        }
      ]
    },
    {
      "source": "/landing_ai-made-simple-page.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow, noarchive"
        }
      ]
    },
    {
      "source": "/l/platform-engineering-playbook/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow, noarchive"
        }
      ]
    },
    {
      "source": "/l/finops-ops-playbook/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow, noarchive"
        }
      ]
    },
    {
      "source": "/l/data-pipelines-playbook/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow, noarchive"
        }
      ]
    },
    {
      "source": "/ai-leverage-week/replay-ended",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
