+.hero-media .frame-caption{display:flex;justify-content:space-between;gap:1rem;padding:.8rem .35rem .95rem;font-family:JetBrains Mono,monospace;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
+.hero-media .frame-caption strong{color:var(--accent);font-weight:600}
+.hero-media::before,.hero-media::after{content:"";position:absolute;width:14px;height:14px;border:2px solid var(--accent);pointer-events:none}
+.hero-media::before{top:-2px;left:-2px;border-right:0;border-bottom:0;border-top-left-radius:6px}
+.hero-media::after{bottom:-2px;right:-2px;border-left:0;border-top:0;border-bottom-right-radius:6px}
+
+/* ---------- Cards ---------- */
+.card{position:relative;display:block;background:var(--surface);color:var(--ink-2);border-radius:var(--radius);padding:1.6rem;border:1px solid var(--line);text-decoration:none;transition:transform .2s,border-color .2s,box-shadow .2s}
