+/* ============================================================
+   Tayoca canonical public shell — v2 (Arena redesign)
+   One coherent visual system for the whole company platform.
+   Dark warm canvas · amber signal · Sora/Inter/JetBrains Mono.
+
+   CONTRACT: the `.stage10-*` block below is part of the locked
+   Stage 10 product-ecosystem contract (validate_product_ecosystem.py).
+   Do not rename, remove, or reshape those classes or markers.
+   ============================================================ */
+
+:root{
+  --bg:#0d0d0d; --surface:#171717; --surface-2:#1d1b18; --surface-3:#26231f;
+  --ink:#f5f4f1; --ink-2:#d8d5d0; --muted:#a3a3a3;
+  --line:#2e2b27; --line-2:#3a352e;
+  --accent:#f97316; --accent-2:#fb923c; --accent-ink:#1a0f06;
+  --paper:#faf6ef;
+  --max:1200px; --radius:14px;
+}
+*{box-sizing:border-box}
+html{scroll-behavior:smooth}
+body{margin:0;background:var(--bg);color:var(--ink-2);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased}
+a{color:inherit}
+img{max-width:100%;display:block}
+h1,h2,h3,h4{font-family:Sora,Inter,system-ui,sans-serif;color:var(--ink);line-height:1.14;letter-spacing:-.03em;margin:0 0 .75rem}
+p{margin:0 0 1rem}
+::selection{background:var(--accent);color:var(--accent-ink)}
+
+/* ---------- Accessibility ---------- */
+.skip-link{position:fixed;left:1rem;top:-6rem;z-index:2000;padding:.7rem 1rem;border-radius:.4rem;background:var(--accent);color:var(--accent-ink)!important;font:700 .9rem/1.2 Inter,system-ui,sans-serif;text-decoration:none}
 .skip-link:focus{top:1rem}
+.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
+a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--accent-2);outline-offset:2px;border-radius:4px}
+
+/* ---------- Header (canonical) ---------- */
+.site-header{position:sticky;top:0;z-index:1000;background:rgba(13,13,13,.92);border-bottom:1px solid var(--line);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
+.site-header .header-inner{max-width:var(--max);margin:0 auto;min-height:68px;padding:.7rem 1.5rem;display:flex;align-items:center;gap:1.4rem}
+.site-header .brand{font-family:Sora,Inter,system-ui,sans-serif;font-size:1.12rem;font-weight:800;letter-spacing:.16em;color:#fff;text-decoration:none;white-space:nowrap;display:inline-flex;align-items:center;gap:.6rem}
+.site-header .brand::before{content:"";width:11px;height:11px;background:var(--accent);border-radius:2px;flex:none}
+.site-header .brand:hover{color:var(--accent-2)}
+.site-header .primary-nav{margin-left:auto;display:flex;align-items:center;gap:1.55rem}
+.site-header .primary-nav a{font-family:Inter,system-ui,sans-serif;color:#d7d7d7;text-decoration:none;font-size:.92rem;font-weight:600;line-height:1.2;padding:.35rem 0;border-bottom:2px solid transparent}
+.site-header .primary-nav a:hover,.site-header .primary-nav a:focus-visible{color:#fff;border-bottom-color:var(--accent)}
+.site-header .primary-nav a[aria-current="page"]{color:var(--accent);border-bottom-color:var(--accent)}
+.site-header .header-cta{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:.68rem 1.05rem;border-radius:.5rem;background:var(--accent);color:var(--accent-ink)!important;text-decoration:none!important;font-family:Inter,system-ui,sans-serif;font-size:.88rem;font-weight:800;white-space:nowrap;border:1px solid var(--accent);transition:background .15s,transform .15s}
+.site-header .header-cta:hover,.site-header .header-cta:focus-visible{background:var(--accent-2);border-color:var(--accent-2);transform:translateY(-1px)}
+.site-header .menu-toggle{display:none;margin-left:auto;min-height:42px;padding:.5rem .85rem;border:1px solid var(--line-2);border-radius:.5rem;background:var(--surface);color:#fff;font:700 .9rem/1 Inter,system-ui,sans-serif;cursor:pointer}
+
+/* ---------- Layout ---------- */
+.container{max-width:var(--max);margin:0 auto;padding-left:1.5rem;padding-right:1.5rem}
+main{overflow:hidden}
+.section{padding:4.75rem 0}
+.section.compact{padding:3rem 0}
+.band{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
+.band-warm{background:linear-gradient(180deg,#15120e 0%,#1a1611 100%);border-top:1px solid #2c2519;border-bottom:1px solid #2c2519}
+.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.35rem}
+.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
+.grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}
+
+/* ---------- Ledger annotation ---------- */
+.ledger-label{display:inline-flex;align-items:center;gap:.55rem;margin:0 0 .9rem;color:var(--accent);font-family:JetBrains Mono,monospace;font-size:.76rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
+.ledger-label::before{content:"";width:1.9rem;height:2px;background:var(--accent)}
+.section-heading{max-width:820px;margin:0 0 2.6rem}
+.section-heading.center{margin-left:auto;margin-right:auto;text-align:center}
+.section-heading h2{font-size:clamp(1.9rem,3.8vw,2.7rem);margin-bottom:.8rem}
+.section-heading p{color:var(--muted);font-size:1.05rem;margin:0}
+
+/* ---------- Buttons ---------- */
+.actions{display:flex;align-items:center;flex-wrap:wrap;gap:.8rem;margin-top:1.7rem}
+.button{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;padding:.78rem 1.3rem;background:var(--accent);color:var(--accent-ink);border:1px solid var(--accent);border-radius:.55rem;font:inherit;font-weight:700;text-decoration:none;cursor:pointer;transition:transform .16s,background .16s,border-color .16s,box-shadow .16s}
+.button:hover{background:var(--accent-2);border-color:var(--accent-2);transform:translateY(-2px);box-shadow:0 10px 26px rgba(249,115,22,.18)}
+.button.secondary{background:var(--surface-3);border-color:var(--line-2);color:#fff}
+.button.secondary:hover{background:#332e27;border-color:#55493b;box-shadow:0 10px 26px rgba(0,0,0,.35)}
+.button.ghost{background:transparent;border-color:var(--line-2);color:var(--ink)}
+.button.ghost:hover{border-color:var(--accent);color:#fff;box-shadow:none}
+.button.full{width:100%}
+.button.small{padding:.6rem 1rem;font-size:.88rem;min-height:38px}
+.button .arrow{margin-left:.1rem}
+
+/* ---------- Hero ---------- */
+.hero{max-width:var(--max);margin:0 auto;padding:5.5rem 1.5rem 4.5rem}
+.hero.home{min-height:auto;padding-top:5.5rem;padding-bottom:5rem}
+.hero-inner{max-width:920px}
+.hero.home .hero-inner{max-width:var(--max)}
+.hero.center .hero-inner{margin:0 auto;text-align:center}
+.eyebrow{margin:0 0 .8rem;color:var(--accent);font-family:JetBrains Mono,monospace;font-size:.78rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase}
+.hero h1{font-size:clamp(2.5rem,6vw,4.35rem);line-height:1.06;letter-spacing:-.04em;margin:0 0 1.3rem}
+.hero h1 .accent{color:var(--accent)}
+.hero .lede{font-size:clamp(1.05rem,1.9vw,1.28rem);color:#d4d4d4;max-width:760px;margin:0}
+.hero.center .lede{margin-left:auto;margin-right:auto}
+.hero.center .actions{justify-content:center}
+.microcopy{color:var(--muted);font-size:.9rem;margin:1.15rem 0 0}
+.amber-rule{height:5px;background:var(--accent);width:100%}
+
+/* Split hero (home) with media panel */
+.hero-split{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:3.2rem;align-items:center}
+.hero-media{position:relative;border:1px solid var(--line-2);border-radius:18px;background:var(--surface);padding:.8rem .8rem 0;box-shadow:0 30px 70px rgba(0,0,0,.45)}
+.hero-media .frame{border-radius:12px;overflow:hidden;background:#111}
