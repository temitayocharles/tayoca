# Local environment template for tayoca.com development
# Copy this file to .env.local and replace placeholders locally.

# InsForge API Configuration
INSFORGE_API_BASE=https://v7mhrspk.us-east.insforge.app
INSFORGE_PROJECT_ID=tayoca-newsletter
INSFORGE_API_KEY=your-insforge-api-key-here

# Optional: Cloudflare Pages Functions environment binding
PAGES=1

# Local development/testing
NODE_ENV=development
