# Local environment variables for tayoca.com development
# Copy this to .env.local and fill in the values from your InsForge project

# InsForge API Configuration
INSFORGE_API_BASE=https://v7mhrspk.us-east.insforge.app
INSFORGE_PROJECT_ID=tayoca-newsletter
INSFORGE_API_KEY=your-insforge-api-key-here

# Optional: For Cloudflare Pages Functions environment bindings
PAGES=1

# For local development/testing
NODE_ENV=development
