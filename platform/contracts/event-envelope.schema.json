{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tayoca.dev/contracts/event-envelope.schema.json",
  "title": "Tayoca Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "tenant_id", "occurred_at", "source", "subject", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 8 },
    "event_type": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "tenant_id": { "type": "string", "minLength": 3 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": ["string", "null"] },
    "causation_id": { "type": ["string", "null"] },
    "source": { "type": "string", "minLength": 2 },
    "subject": { "type": "object" },
    "payload": { "type": "object" },
    "metadata": { "type": "object", "default": {} }
  }
}