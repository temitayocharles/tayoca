{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tayoca.com/schemas/editorial-opportunity.schema.json",
  "title": "Tayoca Editorial Opportunity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunity_id",
    "source_type",
    "source_ref",
    "source",
    "fact",
    "evidence",
    "commercial_significance",
    "audience",
    "story_angle",
    "recommended_format",
    "disclosure_classification",
    "disclosure_safety_score",
    "redaction_requirements",
    "approval_state",
    "cta",
    "content_opportunity_score",
    "draft_eligibility",
    "correction_status",
    "revision"
  ],
  "properties": {
    "opportunity_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "source_type": {"enum": ["product_catalog", "repository_intelligence", "customer_evidence", "analytics", "editorial_research", "commercial_signal"]},
    "source_ref": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "fact": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "commercial_significance": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "story_angle": {"type": "string", "minLength": 1},
    "recommended_format": {
      "enum": [
        "newsletter",
        "technical_article",
        "executive_brief",
        "case_study",
        "product_update",
        "linkedin_post",
        "short_form_social_content",
        "sales_enablement_asset",
        "no_publication"
      ]
    },
    "disclosure_classification": {"enum": ["public_verified", "public_sensitive_internal", "private_restricted", "legal_review_required", "customer_permission_required"]},
    "disclosure_safety_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "redaction_requirements": {"type": "string"},
    "approval_state": {"enum": ["review_required", "approved_for_drafting", "rejected", "superseded", "correction_pending"]},
    "approval_requested_at": {"type": "string"},
    "approved_at": {"type": "string"},
    "cta": {"type": "string"},
    "campaign_association": {"type": "string"},
    "performance_record": {"type": "string"},
    "content_opportunity_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "draft_eligibility": {"enum": ["eligible_after_approval", "blocked_restricted_source", "blocked_correction_pending", "blocked_rejected", "blocked_superseded"]},
    "correction_status": {"enum": ["none", "pending", "corrected"]},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes_opportunity_id": {"type": "string"},
    "owner": {"type": "string"},
    "notes": {"type": "string"}
  }
}
